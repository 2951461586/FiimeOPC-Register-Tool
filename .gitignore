# ── 本地凭据（**不进仓库**）──────────────────────────────────────
# 已被 .gitignore 排除。模板见 .env.example。
.env

# ── 台账（**含明文 API Key / 账号密码**）─────────────────────────
# 整目录排除。台账必须存明文 —— key 只在创建时返回一次，不存就白注册。
ledger/

# ── 工作区（状态 / 代理池 / 临时文件 / 备份）──────────────────────
# 含出口 IP、计数状态、日志（可能带凭据），整目录排除。
.workbuddy-ai/

# ── Python ───────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
env/

# ── 测试 / 静态检查缓存 ──────────────────────────────────────────
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# ── 编辑器 / 系统 ────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# ── 导出物 ───────────────────────────────────────────────────────
# 导出的 key 清单也是明文凭据。
keys*.json
export*.csv
*.tmp
*.tmp.*
